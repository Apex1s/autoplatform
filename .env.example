# ---------- LLM providers (both free, no credit card) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Order providers are tried in; the next one takes over on 429 / timeout.
LLM_PROVIDER_ORDER=groq,gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_ROUNDS=2
LLM_BACKOFF_BASE=0.5
LLM_BACKOFF_MAX=8
LLM_DEFAULT_COOLDOWN=30

# ---------- Postgres (Neon or Supabase free tier) ----------
# Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Prefer the -pooler host in production. Leave empty to use a local SQLite file (dev only).
DATABASE_URL=
# auto = small pool, emptied after DB_IDLE_DISPOSE_SECONDS idle for Neon/Supabase (compute can
# scale to zero); queue = plain pool; null = no pooling
DATABASE_POOL=auto
DB_IDLE_DISPOSE_SECONDS=120

# ---------- Redis (Upstash free tier, TCP/TLS endpoint) ----------
# rediss://default:PASSWORD@xxx.upstash.io:6379
# Use memory:// for an in-process fake (dev/tests only).
UPSTASH_REDIS_URL=
# Optional HTTPS transport for hosts that block port 6379 (e.g. Hugging Face Spaces).
# If both are set they win over UPSTASH_REDIS_URL. Token = the password in the TCP URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Security ----------
# Bearer token for /admin/* (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
# Lower-privilege bearer token for /cron/* (manual calls). Falls back to ADMIN_TOKEN.
CRON_TOKEN=
# Keyless cron auth: accept GitHub Actions OIDC tokens minted by this repo's main branch
CRON_OIDC_REPOSITORY=
CRON_OIDC_AUDIENCE=autoplatform-cron
CRON_OIDC_REF=refs/heads/main
# Optional: require this bearer token on /metrics
METRICS_TOKEN=

# ---------- Runtime ----------
APP_ENV=development
# Optional: links in API responses. Empty = derived from each request's host.
PUBLIC_BASE_URL=
PORT=7860
RUN_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
# Blocking-pop timeout. Idle cost ~2 commands per poll, independent of concurrency.
# 30s = ~175K commands/month idle (Upstash free tier: 500K/month).
WORKER_POLL_TIMEOUT=30
# Liveness heartbeat, stored in Redis
HEARTBEAT_INTERVAL=60
# Extra worker-health writes to Postgres; 0 = only at start/stop and during /cron/maintenance
# (lets Neon's free compute scale to zero between cron runs)
WORKER_HEALTH_PERSIST_SECONDS=1800
JOB_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3
# First retry delay; doubles each attempt (capped at 600s)
JOB_RETRY_BASE_SECONDS=5
LOG_RETENTION_DAYS=14
QUEUE_PREFIX=ap
LOG_LEVEL=INFO
