# ---------- LLM providers (both free, no credit card) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Order providers are tried in; the next one takes over on 429 / timeout.
LLM_PROVIDER_ORDER=groq,gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_ROUNDS=2
LLM_BACKOFF_BASE=0.5
LLM_BACKOFF_MAX=8
LLM_DEFAULT_COOLDOWN=30

# ---------- Postgres (Neon or Supabase free tier) ----------
# Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Leave empty to use a local SQLite file (dev only).
DATABASE_URL=

# ---------- Redis (Upstash free tier, TCP/TLS endpoint) ----------
# rediss://default:PASSWORD@xxx.upstash.io:6379
# Use memory:// for an in-process fake (dev/tests only).
UPSTASH_REDIS_URL=

# ---------- Security ----------
# Bearer token for /admin/* (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
# Lower-privilege bearer token for /cron/* (GitHub Actions). Falls back to ADMIN_TOKEN.
CRON_TOKEN=
# Optional: require this bearer token on /metrics
METRICS_TOKEN=

# ---------- Runtime ----------
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:7860
PORT=7860
RUN_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
# Blocking-pop timeout. Higher = fewer Redis commands (Upstash free tier has a monthly command quota).
WORKER_POLL_TIMEOUT=30
HEARTBEAT_INTERVAL=60
JOB_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3
LOG_RETENTION_DAYS=14
QUEUE_PREFIX=ap
LOG_LEVEL=INFO
